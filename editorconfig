root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,json,toml,yml,yaml,cff}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# The application source is stored with CRLF line endings (see .gitattributes).
[GitHub_Developer_Analytics.py]
end_of_line = crlf
insert_final_newline = false
max_line_length = 135

[*.{bat,cmd}]
end_of_line = crlf
